# Everything here is OPTIONAL. Khata Bol starts and works for Hindi/Hinglish/English with no keys at all.

# AI enhancement (understands Kannada/Tamil/etc. and unusual phrasings). Either key works; Anthropic wins if both are set.
# A Gemini key also enables the optional audio recognizer (better than Chrome's in noisy shops).
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# GEMINI_MODEL=gemini-3.6-flash
# ANTHROPIC_MODEL=the-model-id
# PORT=8787
# KHATA_DB=data/khata.db
